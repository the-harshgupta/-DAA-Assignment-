4 – Median of Two Sorted Arrays

solution:- 
class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {

        int n = nums1.length;
        int m = nums2.length;
        int merge[] = new int[n+m];
        int k = 0;
        for(int i = 0;i<n;i++){
            merge[k++] = nums1[i];
        }
        for(int i = 0;i<m;i++){
            merge[k++] = nums2[i];
        }
        Arrays.sort(merge);
        int len = merge.length;
        if(len % 2 == 1) {
            return merge[len / 2];
        }
        
        return (merge[len / 2] + merge[(len / 2) - 1]) / 2.0;
        
    }

}
